{
  "id": "vocab",
  "title": "Словарь зала и кухни",
  "sections": [
    {
      "id": "sala",
      "title": "Зал и бар: жаргон и предметы",
      "items": [
        {"id": "voc-sala-01", "kind": "word", "ru": "заказ (бумажка/запись для кухни)", "es": "la comanda", "en": "the order ticket", "note": "«Pasar la comanda» — передать заказ на кухню/в систему"},
        {"id": "voc-sala-02", "kind": "word", "ru": "счёт", "es": "la cuenta", "en": "the bill / the check", "note": "«¿Me cobras?» — гость просит рассчитать (разговорно)"},
        {"id": "voc-sala-03", "kind": "word", "ru": "терминал для карт", "es": "el datáfono", "en": "the card machine", "note": "«Te traigo el datáfono» — несу терминал"},
        {"id": "voc-sala-04", "kind": "word", "ru": "чаевые / общая копилка чаевых", "es": "la propina / el bote", "en": "the tip / the tip jar", "note": "«El bote» — общая банка чаевых, которую делят между сменой"},
        {"id": "voc-sala-05", "kind": "word", "ru": "меню (книжка с блюдами)", "es": "la carta", "en": "the menu", "note": "Ловушка: «menú» в Испании — это комплексный обед (menú del día), а книжка — «la carta»"},
        {"id": "voc-sala-06", "kind": "word", "ru": "комплексный обед дня", "es": "el menú del día", "en": "the set lunch menu", "note": "Обычно пн–пт в обед: первое, второе, хлеб, напиток, десерт или кофе за фикс. цену"},
        {"id": "voc-sala-07", "kind": "word", "ru": "блюдо дня", "es": "el plato del día", "en": "today's special"},
        {"id": "voc-sala-08", "kind": "word", "ru": "блюдо вне меню (спецпредложение)", "es": "fuera de carta", "en": "off-menu special", "note": "«Hoy tenemos fuera de carta…» — сильный повод для рекомендации"},
        {"id": "voc-sala-09", "kind": "word", "ru": "порция / полпорции", "es": "una ración / media ración", "en": "a full portion / a half portion", "note": "Ración — большая тарелка на компанию, media — поменьше"},
        {"id": "voc-sala-10", "kind": "word", "ru": "тапа (маленькая порция к напитку)", "es": "una tapa", "en": "a small tapa"},
        {"id": "voc-sala-11", "kind": "word", "ru": "пинчо (закуска на хлебе/шпажке)", "es": "un pincho", "en": "a pintxo / small bite on bread", "note": "«Un pincho de tortilla» — кусок тортильи"},
        {"id": "voc-sala-12", "kind": "word", "ru": "на компанию, чтобы поделить", "es": "para compartir", "en": "to share", "note": "«¿Es para compartir o para cada uno?»"},
        {"id": "voc-sala-13", "kind": "word", "ru": "приборы / сервировка на одного", "es": "los cubiertos / un cubierto", "en": "cutlery / a place setting", "note": "«Un cubierto más» — добавить место за столом"},
        {"id": "voc-sala-14", "kind": "word", "ru": "салфетка", "es": "la servilleta", "en": "the napkin"},
        {"id": "voc-sala-15", "kind": "word", "ru": "скатерть", "es": "el mantel", "en": "the tablecloth"},
        {"id": "voc-sala-16", "kind": "word", "ru": "поднос", "es": "la bandeja", "en": "the tray"},
        {"id": "voc-sala-17", "kind": "word", "ru": "кувшин", "es": "la jarra", "en": "the jug / pitcher", "note": "«Una jarra de agua», «una jarra de sangría»; также большая пивная кружка"},
        {"id": "voc-sala-18", "kind": "word", "ru": "масло и уксус для стола (набор)", "es": "las vinagreras / la aceitera", "en": "oil and vinegar set / the oil cruet"},
        {"id": "voc-sala-19", "kind": "word", "ru": "зубочистки", "es": "los palillos", "en": "toothpicks"},
        {"id": "voc-sala-20", "kind": "word", "ru": "терраса (столики на улице)", "es": "la terraza", "en": "the terrace / outdoor seating", "note": "На террасе цены иногда выше — гости могут спросить"},
        {"id": "voc-sala-21", "kind": "word", "ru": "барная стойка", "es": "la barra", "en": "the bar counter", "note": "«¿En barra o en mesa?»"},
        {"id": "voc-sala-22", "kind": "word", "ru": "подсобка/сервисная зона (посудомойка, хранение)", "es": "el office", "en": "the service area / back of house", "note": "Произносят «óфис»"},
        {"id": "voc-sala-23", "kind": "word", "ru": "бронь / забронировать", "es": "la reserva / reservar", "en": "the booking / to book"},
        {"id": "voc-sala-24", "kind": "word", "ru": "накрыть / убрать стол", "es": "montar / desmontar la mesa", "en": "to set / clear the table", "note": "Также «recoger la mesa» — убрать после гостей"},
        {"id": "voc-sala-25", "kind": "word", "ru": "заготовка/подготовка перед сменой", "es": "la mise en place", "en": "the mise en place / prep", "note": "В зале: протереть приборы, заполнить салфетки, соль, масло"},
        {"id": "voc-sala-26", "kind": "word", "ru": "поменять кегу пива", "es": "cambiar el barril", "en": "to change the keg", "note": "«Se ha acabado el barril» — кега кончилась, пиво пенится"},
        {"id": "voc-sala-27", "kind": "word", "ru": "раздача (окно, где кухня выдаёт блюда)", "es": "el pase", "en": "the pass", "note": "«¡Pase!» / «¡Sale la 5!» — кухня зовёт забрать блюда"},
        {"id": "voc-sala-28", "kind": "word", "ru": "менеджер смены / старший", "es": "el encargado / la encargada", "en": "the shift manager"},
        {"id": "voc-sala-29", "kind": "word", "ru": "метрдотель / старший по залу", "es": "el jefe de sala / la jefa de sala", "en": "the head waiter / maître d'"},
        {"id": "voc-sala-30", "kind": "word", "ru": "раздельная смена (обед + вечер с перерывом)", "es": "el turno partido", "en": "a split shift", "note": "Частая схема в Испании: 12–16 и 20–24"},
        {"id": "voc-sala-31", "kind": "word", "ru": "«понял / принято» (ответ кухне или коллеге)", "es": "¡Oído!", "en": "Heard! / Got it!", "note": "Говорят, когда кухня или коллега передаёт заказ"},
        {"id": "voc-sala-32", "kind": "word", "ru": "«готовлю! / сейчас будет» (подтверждение заказа)", "es": "¡Marchando!", "en": "Coming right up!", "note": "«Marchando una de bravas» — классика бара"},
        {"id": "voc-sala-33", "kind": "word", "ru": "стол номер…", "es": "la (mesa) cinco", "en": "table five", "note": "Столы называют по номеру в женском роде: «la 5», «la 12»"},
        {"id": "voc-sala-34", "kind": "word", "ru": "хлеб и закуска на стол (бывает платным)", "es": "el pan y el aperitivo", "en": "bread and nibbles", "note": "Хлеб иногда идёт в счёт отдельной строкой — лучше заранее знать правило заведения"}
      ]
    },
    {
      "id": "cocina",
      "title": "Кухня: способы приготовления",
      "items": [
        {"id": "voc-cocina-01", "kind": "word", "ru": "на гриле-плите (раскалённая плоская поверхность)", "es": "a la plancha", "en": "griddled / grilled on a flat-top"},
        {"id": "voc-cocina-02", "kind": "word", "ru": "на углях", "es": "a la brasa", "en": "char-grilled over embers", "note": "Звучит премиально — «a la brasa» отлично продаёт мясо и рыбу"},
        {"id": "voc-cocina-03", "kind": "word", "ru": "на решётке (гриль)", "es": "a la parrilla", "en": "grilled (on a grill rack)"},
        {"id": "voc-cocina-04", "kind": "word", "ru": "запечённый в духовке", "es": "al horno", "en": "oven-baked / roasted"},
        {"id": "voc-cocina-05", "kind": "word", "ru": "жареный во фритюре/на масле", "es": "frito", "en": "fried"},
        {"id": "voc-cocina-06", "kind": "word", "ru": "в кляре", "es": "rebozado", "en": "battered"},
        {"id": "voc-cocina-07", "kind": "word", "ru": "в панировке (сухари)", "es": "empanado", "en": "breaded"},
        {"id": "voc-cocina-08", "kind": "word", "ru": "тушёное блюдо / рагу", "es": "un guiso / guisado", "en": "a stew / stewed"},
        {"id": "voc-cocina-09", "kind": "word", "ru": "тушёное (обычно мясо, долго)", "es": "estofado", "en": "braised / stewed"},
        {"id": "voc-cocina-10", "kind": "word", "ru": "жаркое, запечённое целиком", "es": "asado", "en": "roast"},
        {"id": "voc-cocina-11", "kind": "word", "ru": "на пару", "es": "al vapor", "en": "steamed", "note": "Мидии «al vapor» — классика"},
        {"id": "voc-cocina-12", "kind": "word", "ru": "в лёгком кляре (мука+яйцо), «по-римски»", "es": "a la romana", "en": "lightly battered and fried", "note": "Calamares a la romana — кольца кальмара"},
        {"id": "voc-cocina-13", "kind": "word", "ru": "с чесноком в масле (часто с острым перцем)", "es": "al ajillo", "en": "in garlic and olive oil"},
        {"id": "voc-cocina-14", "kind": "word", "ru": "в масле с чесноком и острым перцем, подаётся шкворчащим", "es": "al pil pil", "en": "sizzling with garlic and chilli", "note": "Gambas al pil pil; в Стране Басков pil pil — ещё и эмульсия к треске"},
        {"id": "voc-cocina-15", "kind": "word", "ru": "по-морскому (соус: лук, томат, белое вино)", "es": "a la marinera", "en": "in a seafood-style tomato and wine sauce"},
        {"id": "voc-cocina-16", "kind": "word", "ru": "конфи (томлённый в жиру на низкой температуре)", "es": "confitado", "en": "confit"},
        {"id": "voc-cocina-17", "kind": "word", "ru": "томлённый (обжарен, потом долго тушится)", "es": "braseado", "en": "braised"},
        {"id": "voc-cocina-18", "kind": "word", "ru": "быстро обжаренный (соте)", "es": "salteado", "en": "sautéed / stir-fried"},
        {"id": "voc-cocina-19", "kind": "word", "ru": "запечённый с корочкой (сыр/соус сверху)", "es": "gratinado", "en": "au gratin"},
        {"id": "voc-cocina-20", "kind": "word", "ru": "сырой", "es": "crudo", "en": "raw", "note": "Также о мясе: «está crudo» — недожарено (жалоба)"},
        {"id": "voc-cocina-21", "kind": "word", "ru": "маринованный", "es": "marinado / en adobo", "en": "marinated", "note": "Adobo — маринад с паприкой, уксусом, чесноком (cazón en adobo)"},
        {"id": "voc-cocina-22", "kind": "word", "ru": "в собственных чернилах", "es": "en su tinta", "en": "in its own ink", "note": "Calamares/chipirones en su tinta"},
        {"id": "voc-cocina-23", "kind": "word", "ru": "гарнир", "es": "la guarnición", "en": "the side (dish)", "note": "«¿Qué lleva de guarnición?» — «Patatas y pimientos»"},
        {"id": "voc-cocina-24", "kind": "word", "ru": "соус", "es": "la salsa", "en": "the sauce"},
        {"id": "voc-cocina-25", "kind": "word", "ru": "заправка (масло, уксус, соль)", "es": "el aliño", "en": "the dressing", "note": "«¿Os aliño la ensalada?» — заправить салат вам?"},
        {"id": "voc-cocina-26", "kind": "word", "ru": "хрустящая поджаренная корочка риса на дне паэльи", "es": "el socarrat", "en": "the crispy rice crust at the bottom", "note": "Гордость хорошей паэльи — валенсийцы её ценят"},
        {"id": "voc-cocina-27", "kind": "word", "ru": "домашний (по-домашнему)", "es": "casero", "en": "homemade", "note": "«Croquetas caseras», «flan casero» — продающее слово"},
        {"id": "voc-cocina-28", "kind": "word", "ru": "сезонный / рыночный (свежий продукт дня)", "es": "de temporada / de mercado", "en": "seasonal / market-fresh"}
      ]
    },
    {
      "id": "punto",
      "title": "Прожарка и особые просьбы",
      "items": [
        {"id": "voc-punto-01", "kind": "word", "ru": "почти сырое (только обжарено с двух сторон)", "es": "vuelta y vuelta", "en": "blue / very rare"},
        {"id": "voc-punto-02", "kind": "word", "ru": "с кровью", "es": "poco hecho", "en": "rare", "note": "Синоним: «sangrante»"},
        {"id": "voc-punto-03", "kind": "word", "ru": "средняя прожарка", "es": "al punto", "en": "medium-rare / medium", "note": "«Al punto» в Испании — розовое внутри; уточни у кухни, как они понимают"},
        {"id": "voc-punto-04", "kind": "word", "ru": "прожаренное", "es": "hecho", "en": "medium-well / well done"},
        {"id": "voc-punto-05", "kind": "word", "ru": "сильно прожаренное", "es": "muy hecho", "en": "well done"},
        {"id": "voc-punto-06", "kind": "word", "ru": "«Как вам приготовить мясо?»", "es": "¿Cómo te/os gusta la carne? / ¿Qué punto?", "en": "How would you like it cooked?"},
        {"id": "voc-punto-07", "kind": "word", "ru": "без глютена", "es": "sin gluten", "en": "gluten-free", "note": "Целиак = «celíaco/celíaca»: нужна не только замена, но и отсутствие перекрёстного контакта (фритюр!)"},
        {"id": "voc-punto-08", "kind": "word", "ru": "без лактозы", "es": "sin lactosa", "en": "lactose-free"},
        {"id": "voc-punto-09", "kind": "word", "ru": "без лука", "es": "sin cebolla", "en": "no onion", "note": "Шаблон: «sin + ingrediente» — sin ajo, sin picante, sin mayonesa"},
        {"id": "voc-punto-10", "kind": "word", "ru": "отдельно (соус отдельно)", "es": "aparte (la salsa aparte)", "en": "on the side"},
        {"id": "voc-punto-11", "kind": "word", "ru": "тёплый (не горячий)", "es": "templado", "en": "lukewarm"},
        {"id": "voc-punto-12", "kind": "word", "ru": "комнатной температуры (о напитке) / холодный", "es": "del tiempo / frío", "en": "room temperature / cold", "note": "«¿El agua fría o del tiempo?» — частый вопрос в Испании"},
        {"id": "voc-punto-13", "kind": "word", "ru": "острый / не острый", "es": "picante / que no pique", "en": "spicy / not spicy", "note": "«¿Pica mucho?» — «Pica un poquito»"}
      ]
    },
    {
      "id": "vajilla",
      "title": "Посуда и стекло",
      "items": [
        {"id": "voc-vajilla-01", "kind": "word", "ru": "мелкая тарелка", "es": "el plato llano", "en": "dinner plate"},
        {"id": "voc-vajilla-02", "kind": "word", "ru": "глубокая тарелка", "es": "el plato hondo", "en": "soup bowl / deep plate"},
        {"id": "voc-vajilla-03", "kind": "word", "ru": "десертная тарелка", "es": "el plato de postre", "en": "dessert plate"},
        {"id": "voc-vajilla-04", "kind": "word", "ru": "бокал для вина", "es": "la copa de vino", "en": "wine glass", "note": "«Copa» — бокал на ножке, «vaso» — стакан"},
        {"id": "voc-vajilla-05", "kind": "word", "ru": "большой бокал-шар (для джин-тоника)", "es": "la copa balón", "en": "balloon glass"},
        {"id": "voc-vajilla-06", "kind": "word", "ru": "бокал/стакан для «каньи» (малое разливное)", "es": "el vaso de caña", "en": "small beer glass"},
        {"id": "voc-vajilla-07", "kind": "word", "ru": "высокий узкий стакан", "es": "el tubo", "en": "highball / tall glass", "note": "«Un tubo de cerveza» — пиво в высоком стакане"},
        {"id": "voc-vajilla-08", "kind": "word", "ru": "рюмка / шот", "es": "el chupito", "en": "shot glass / a shot"},
        {"id": "voc-vajilla-09", "kind": "word", "ru": "чашка", "es": "la taza", "en": "cup"},
        {"id": "voc-vajilla-10", "kind": "word", "ru": "блюдце", "es": "el platillo", "en": "saucer"},
        {"id": "voc-vajilla-11", "kind": "word", "ru": "чайная ложка", "es": "la cucharilla", "en": "teaspoon"},
        {"id": "voc-vajilla-12", "kind": "word", "ru": "нож для мяса", "es": "el cuchillo de carne", "en": "steak knife"},
        {"id": "voc-vajilla-13", "kind": "word", "ru": "рыбная лопатка (нож для рыбы)", "es": "la pala de pescado", "en": "fish knife"},
        {"id": "voc-vajilla-14", "kind": "word", "ru": "большое сервировочное блюдо", "es": "la fuente", "en": "serving platter"},
        {"id": "voc-vajilla-15", "kind": "word", "ru": "глиняная кастрюлька (для тап и запеканок)", "es": "la cazuela de barro", "en": "clay dish", "note": "Горячая! «Cuidado, que quema»"},
        {"id": "voc-vajilla-16", "kind": "word", "ru": "сковорода для паэльи", "es": "la paellera / la paella", "en": "paella pan", "note": "В Валенсии сама сковорода и называется «paella»"},
        {"id": "voc-vajilla-17", "kind": "word", "ru": "ведёрко со льдом (для бутылки)", "es": "la cubitera / el cubo de hielo", "en": "ice bucket"}
      ]
    },
    {
      "id": "alergenos",
      "title": "14 аллергенов (обязательны по закону ЕС)",
      "items": [
        {"id": "voc-alergenos-01", "kind": "word", "ru": "злаки с глютеном", "es": "el gluten (cereales con gluten)", "en": "gluten (cereals containing gluten)", "note": "Пшеница, рожь, ячмень, овёс. Скрыто: панировка, кляр, соусы с мукой, пиво, сухари в фарше"},
        {"id": "voc-alergenos-02", "kind": "word", "ru": "ракообразные", "es": "los crustáceos", "en": "crustaceans", "note": "Креветки, лангустины, крабы, омары. Скрыто: бульон для риса (arroz a banda, fideuà)"},
        {"id": "voc-alergenos-03", "kind": "word", "ru": "моллюски", "es": "los moluscos", "en": "molluscs", "note": "Мидии, клóчины, вонголе, кальмар, каракатица, осьминог. Отдельно от ракообразных!"},
        {"id": "voc-alergenos-04", "kind": "word", "ru": "рыба", "es": "el pescado", "en": "fish", "note": "Скрыто: рыбный бульон, анчоусы в соусах, бульоны для риса"},
        {"id": "voc-alergenos-05", "kind": "word", "ru": "яйцо", "es": "el huevo", "en": "egg", "note": "Скрыто: алиоли и майонез, кляр, ensaladilla, десерты"},
        {"id": "voc-alergenos-06", "kind": "word", "ru": "молоко (включая лактозу)", "es": "la leche / los lácteos", "en": "milk / dairy", "note": "Скрыто: бешамель в крокетах, сливочные соусы, десерты"},
        {"id": "voc-alergenos-07", "kind": "word", "ru": "арахис", "es": "los cacahuetes", "en": "peanuts", "note": "Арахис ≠ орехи в списке — это отдельный аллерген"},
        {"id": "voc-alergenos-08", "kind": "word", "ru": "орехи (древесные)", "es": "los frutos de cáscara", "en": "tree nuts", "note": "Миндаль, фундук, грецкий, кешью, фисташки… Скрыто: romesco, tarta de Santiago, picada в соусах. Кедровые орехи (piñones) по закону не в списке, но их всё равно называют гостю"},
        {"id": "voc-alergenos-09", "kind": "word", "ru": "соя", "es": "la soja", "en": "soy"},
        {"id": "voc-alergenos-10", "kind": "word", "ru": "кунжут", "es": "el sésamo", "en": "sesame", "note": "Скрыто: хлеб с кунжутом, тахини, азиатские соусы"},
